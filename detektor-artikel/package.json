{
  "name": "detektor-artikel",
  "version": "1.0.0",
  "private": true,
  "description": "AI Content Analyzer (xscan.es) — detektor tulisan AI dan penilai artikel (Bahasa Indonesia & English) di Cloudflare Workers, data hanya di R2.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "bash test/run-e2e.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "hono": "4.13.16",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.156.1"
  }
}
