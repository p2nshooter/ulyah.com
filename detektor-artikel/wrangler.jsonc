{
  "$schema": "node_modules/wrangler/config-schema.json",
  // AI Content Analyzer (xscan.es) — detektor tulisan AI & penilai artikel. Alamat cadangan: https://detektor-artikel.axto.workers.dev
  "name": "detektor-artikel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev tetap menyala walau domain sendiri sudah terpasang (alamat cadangan).
  "workers_dev": true,
  // Domain sendiri disisipkan saat deploy, hanya bila zonanya sudah aktif — lihat .github/workflows/deploy-detektor-artikel.yml.
  // __CUSTOM_DOMAIN_ROUTES__
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "observability": { "enabled": true },
  // Aturan tetap pemilik: SEMUA data di R2, tidak pernah D1.
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "detektor-data" },
    { "binding": "BACKUPS", "bucket_name": "detektor-backups" }
  ],
  // KV hanya untuk penghitung batas laju (bukan data tahan lama).
  "kv_namespaces": [{ "binding": "RL", "id": "__KV_NAMESPACE_ID__" }],
  "triggers": { "crons": ["* * * * *", "0 19 * * *"] },
  "vars": { "CANONICAL_HOST": "" },
  // ascan.es — mesin yang sama, wajah lain (docs/MASTER-BLUEPRINT.md §19.6). Merek dipilih saat build lewat `define`.
  // Data terpisah total (bucket R2 sendiri) supaya setiap situs bisa berdiri dan dijual sendiri. Tetap R2, tidak pernah D1.
  "env": {
    "ascan": {
      "name": "ascan-es",
      "define": { "__BRAND__": "\"ascan\"" },
      "workers_dev": true,
      // __ASCAN_CUSTOM_DOMAIN_ROUTES__
      "r2_buckets": [
        { "binding": "DATA", "bucket_name": "ascan-data" },
        { "binding": "BACKUPS", "bucket_name": "ascan-backups" }
      ],
      "kv_namespaces": [{ "binding": "RL", "id": "__ASCAN_KV_NAMESPACE_ID__" }],
      "triggers": { "crons": ["* * * * *", "0 19 * * *"] },
      "vars": { "CANONICAL_HOST": "" }
    }
  }
}
