{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quantum-karoseri",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Memberi URL publik gratis https://quantum-karoseri.<subdomain>.workers.dev
  // sehingga sistem bisa dipakai online sebelum domain sendiri dibeli.
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Database sendiri, terpisah penuh dari `ulyah-db`. Tidak ada satu pun tabel
  // yang dibagi: dua proyek ini hanya berbagi akun Cloudflare dan repositori.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quantum-db",
      // Diisi otomatis saat deploy (lihat .github/workflows/deploy-quantum.yml).
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "QUANTUM_KV",
      "id": "__KV_NAMESPACE_ID__"
    }
  ]
}
