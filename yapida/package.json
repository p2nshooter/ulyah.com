{
  "name": "yapida-sch-id",
  "version": "1.0.0",
  "private": true,
  "description": "yapida.sch.id — situs Yayasan Al-Huda Yapida (Sukakarya, Bekasi): profil lembaga, kabar, galeri, video & siaran langsung, perpustakaan digital bersuara, bank soal, karya tulis dan portal berjenjang. Cloudflare Workers, data hanya di R2.",
  "type": "module",
  "scripts": {
    "predev": "npm run pustaka --silent",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p .",
    "pustaka": "tsx scripts/buat-pustaka.ts && npm run klien --silent",
    "pretest": "npm run pustaka --silent",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "bash test/run-e2e.sh",
    "klien": "esbuild src/klien/impor.ts --bundle --format=iife --minify --target=es2020 --log-level=warning --outfile=public/assets/impor.js"
  },
  "dependencies": {
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.156.1"
  }
}
