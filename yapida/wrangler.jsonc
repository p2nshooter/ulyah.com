{
  "$schema": "node_modules/wrangler/config-schema.json",
  // yapida.sch.id — situs Yayasan Al-Huda Yapida (docs/YAPIDA-BLUEPRINT.md). Alamat cadangan: https://yapida-sch-id.<subdomain>.workers.dev
  "name": "yapida-sch-id",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev tetap menyala walau domain sendiri sudah terpasang (alamat cadangan, noindex).
  "workers_dev": true,
  // Domain sendiri disisipkan saat deploy, hanya bila zonanya sudah aktif — lihat .github/workflows/deploy-yapida.yml.
  // __CUSTOM_DOMAIN_ROUTES__
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "observability": { "enabled": true },
  // Aturan tetap pemilik: SEMUA data di R2, tidak pernah D1.
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "yapida-data" },
    { "binding": "MEDIA", "bucket_name": "yapida-media" },
    { "binding": "BACKUPS", "bucket_name": "yapida-backups" }
  ],
  // KV hanya untuk penghitung batas laju (id disisipkan saat deploy); data tahan lama tidak pernah di KV.
  "kv_namespaces": [{ "binding": "RL", "id": "__KV_NAMESPACE_ID__" }],
  // Tanpa cron Cloudflare: batas 5 cron per akun (paket Workers gratis) sudah terpakai situs lain.
  "triggers": { "crons": [] },
  "vars": { "CANONICAL_HOST": "", "MEDIA_BASE": "" }
}
