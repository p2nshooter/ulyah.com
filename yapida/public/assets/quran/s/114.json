{"n":114,"basmalah":true,"ayat":[{"a":1,"ar":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","tr":"Katakanlah, \"Aku berlindung kepada Tuhannya manusia","lt":"Qul aAAoothu birabbi alnnasi","h":604,"j":30,"g":6231},{"a":2,"ar":"مَلِكِ ٱلنَّاسِ","tr":"Raja manusia","lt":"Maliki alnnasi","h":604,"j":30,"g":6232},{"a":3,"ar":"إِلَٰهِ ٱلنَّاسِ","tr":"sembahan manusia","lt":"Ilahi alnnasi","h":604,"j":30,"g":6233},{"a":4,"ar":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","tr":"dari kejahatan (bisikan) setan yang bersembunyi","lt":"Min sharri alwaswasi alkhannasi","h":604,"j":30,"g":6234},{"a":5,"ar":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","tr":"yang membisikkan (kejahatan) ke dalam dada manusia","lt":"Allathee yuwaswisu fee sudoori alnnasi","h":604,"j":30,"g":6235},{"a":6,"ar":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","tr":"dari (golongan) jin dan manusia","lt":"Mina aljinnati wa alnnasm","h":604,"j":30,"g":6236}]}