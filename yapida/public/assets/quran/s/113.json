{"n":113,"basmalah":true,"ayat":[{"a":1,"ar":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ","tr":"Katakanlah, \"Aku berlindung kepada Tuhan yang menguasai subuh (fajar)","lt":"Qul aAAoothu birabbi alfalaqi","h":604,"j":30,"g":6226},{"a":2,"ar":"مِن شَرِّ مَا خَلَقَ","tr":"dari kejahatan (makhluk yang) Dia ciptakan","lt":"Min sharri ma khalaqa","h":604,"j":30,"g":6227},{"a":3,"ar":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","tr":"dan dari kejahatan malam apabila telah gelap gulita","lt":"Wamin sharri ghasiqin itha waqaba","h":604,"j":30,"g":6228},{"a":4,"ar":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ","tr":"dan dari kejahatan (perempuan-perempuan) penyihir yang meniup pada buhul-buhul (talinya)","lt":"Wamin sharri alnnaffathati fee alAAuqadi","h":604,"j":30,"g":6229},{"a":5,"ar":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","tr":"dan dari kejahatan orang yang dengki apabila dia dengki","lt":"Wamin sharri hasidin itha hasada","h":604,"j":30,"g":6230}]}