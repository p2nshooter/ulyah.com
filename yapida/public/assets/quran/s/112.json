{"n":112,"basmalah":true,"ayat":[{"a":1,"ar":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","tr":"Katakanlah (Muhammad), \"Dialah Allah, Yang Maha Esa","lt":"Qul huwa Allahu ahadun","h":604,"j":30,"g":6222},{"a":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","tr":"Allah tempat meminta segala sesuatu","lt":"Allahu alssamadu","h":604,"j":30,"g":6223},{"a":3,"ar":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","tr":"(Allah) tidak beranak dan tidak pula diperanakkan","lt":"Lam yalid walam yooladu","h":604,"j":30,"g":6224},{"a":4,"ar":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","tr":"Dan tidak ada sesuatu yang setara dengan Dia","lt":"Walam yakun lahu kufuwan ahadun","h":604,"j":30,"g":6225}]}