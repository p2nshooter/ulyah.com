{"n":94,"basmalah":true,"ayat":[{"a":1,"ar":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","tr":"Bukankah kami telah melapangkan dadamu (Muhammad)","lt":"Alam nashrah laka sadraka","h":596,"j":30,"g":6091},{"a":2,"ar":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","tr":"dan kami pun telah menurunkan beban darimu","lt":"WawadaAAna AAanka wizraka","h":596,"j":30,"g":6092},{"a":3,"ar":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","tr":"yang memberatkan punggungmu","lt":"Allathee anqada thahraka","h":597,"j":30,"g":6093},{"a":4,"ar":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","tr":"dan kami tinggikan sebutan (nama)mu bagimu","lt":"WarafaAAna laka thikraka","h":597,"j":30,"g":6094},{"a":5,"ar":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","tr":"Maka sesungguhnya bersama kesulitan ada kemudahan","lt":"Fainna maAAa alAAusri yusran","h":597,"j":30,"g":6095},{"a":6,"ar":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰا","tr":"sesungguhnya bersama kesulitan ada kemudahan","lt":"Inna maAAa alAAusri yusran","h":597,"j":30,"g":6096},{"a":7,"ar":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","tr":"Maka apabila engkau telah selesai (dari suatu urusan), tetaplah bekerja keras (untuk urusan yang lain)","lt":"Faitha faraghta fainsab","h":597,"j":30,"g":6097},{"a":8,"ar":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","tr":"dan hanya kepada Tuhanmulah engkau berharap","lt":"Waila rabbika fairghab","h":597,"j":30,"g":6098}]}