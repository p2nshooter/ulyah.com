{"n":104,"basmalah":true,"ayat":[{"a":1,"ar":"وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ","tr":"Celakalah bagi setiap pengumpat dan pencela","lt":"Waylun likulli humazatin lumazatin","h":601,"j":30,"g":6180},{"a":2,"ar":"ٱلَّذِي جَمَعَ مَالࣰا وَعَدَّدَهُۥ","tr":"yang mengumpulkan harta dan menghitung-hitungnya","lt":"Allathee jamaAAa malan waAAaddadahu","h":601,"j":30,"g":6181},{"a":3,"ar":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","tr":"dia (manusia) mengira bahwa hartanya itu dapat mengekalkannya","lt":"Yahsabu anna malahu akhladahu","h":601,"j":30,"g":6182},{"a":4,"ar":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","tr":"Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Ḥuṭamah","lt":"Kalla layunbathanna fee alhutamati","h":601,"j":30,"g":6183},{"a":5,"ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","tr":"Dan tahukah kamu apakah (neraka) Ḥuṭamah itu","lt":"Wama adraka ma alhutamatu","h":601,"j":30,"g":6184},{"a":6,"ar":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","tr":"(Yaitu) api (azab) Allah yang dinyalakan","lt":"Naru Allahi almooqadatu","h":601,"j":30,"g":6185},{"a":7,"ar":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","tr":"yang (membakar) sampai ke hati","lt":"Allatee tattaliAAu AAala alafidati","h":601,"j":30,"g":6186},{"a":8,"ar":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةࣱ","tr":"Sungguh, api itu ditutup rapat atas (diri) mereka","lt":"lnnaha AAalayhim musadatun","h":601,"j":30,"g":6187},{"a":9,"ar":"فِي عَمَدࣲ مُّمَدَّدَةِۭ","tr":"(sedang mereka itu) diikat pada tiang-tiang yang panjang","lt":"Fee AAamadin mumaddadatin","h":601,"j":30,"g":6188}]}