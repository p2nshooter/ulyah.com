{"n":101,"basmalah":true,"ayat":[{"a":1,"ar":"ٱلۡقَارِعَةُ","tr":"Hari Kiamat","lt":"AlqariAAatu","h":600,"j":30,"g":6158},{"a":2,"ar":"مَا ٱلۡقَارِعَةُ","tr":"Apakah hari Kiamat itu","lt":"Ma alqariAAatu","h":600,"j":30,"g":6159},{"a":3,"ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","tr":"Dan tahukah kamu apakah hari Kiamat itu","lt":"Wama adraka ma alqariAAatu","h":600,"j":30,"g":6160},{"a":4,"ar":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","tr":"Pada hari itu manusia seperti laron yang beterbangan","lt":"Yawma yakoonu alnnasu kaalfarashi almabthoothi","h":600,"j":30,"g":6161},{"a":5,"ar":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","tr":"dan gunung-gunung seperti bulu yang dihambur-hamburkan","lt":"Watakoonu aljibalu kaalAAihni almanfooshi","h":600,"j":30,"g":6162},{"a":6,"ar":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","tr":"Maka adapun orang yang berat timbangan (kebaikan)nya","lt":"Faamma man thaqulat mawazeenuhu","h":600,"j":30,"g":6163},{"a":7,"ar":"فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ","tr":"maka dia berada dalam kehidupan yang memuaskan (senang)","lt":"Fahuwa fee AAeeshatin radiyatin","h":600,"j":30,"g":6164},{"a":8,"ar":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","tr":"Dan adapun orang yang ringan timbangan (kebaikan)nya","lt":"Waamma man khaffat mawazeenuhu","h":600,"j":30,"g":6165},{"a":9,"ar":"فَأُمُّهُۥ هَاوِيَةࣱ","tr":"maka tempat kembalinya adalah neraka Hāwiyah","lt":"Faommuhu hawiyatun","h":600,"j":30,"g":6166},{"a":10,"ar":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","tr":"Dan tahukah kamu apakah neraka Hāwiyah itu","lt":"Wama adraka ma hiyah","h":600,"j":30,"g":6167},{"a":11,"ar":"نَارٌ حَامِيَةُۢ","tr":"(Yaitu) api yang sangat panas","lt":"Narun hamiyatun","h":600,"j":30,"g":6168}]}