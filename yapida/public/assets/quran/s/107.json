{"n":107,"basmalah":true,"ayat":[{"a":1,"ar":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","tr":"Tahukah kamu (orang) yang mendustakan agama","lt":"Araayta allathee yukaththibu bialddeeni","h":602,"j":30,"g":6198},{"a":2,"ar":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","tr":"Maka itulah orang yang menghardik anak yatim","lt":"Fathalika allathee yaduAAAAu alyateema","h":602,"j":30,"g":6199},{"a":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","tr":"dan tidak mengajak memberi makan orang miskin","lt":"Wala yahuddu AAala taAAami almiskeeni","h":602,"j":30,"g":6200},{"a":4,"ar":"فَوَيۡلࣱ لِّلۡمُصَلِّينَ","tr":"Maka celakalah orang yang salat","lt":"Fawaylun lilmusalleena","h":602,"j":30,"g":6201},{"a":5,"ar":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","tr":"(yaitu) orang-orang yang lalai terhadap salatnya","lt":"Allatheena hum AAan salatihim sahoona","h":602,"j":30,"g":6202},{"a":6,"ar":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","tr":"yang berbuat riya","lt":"Allatheena hum yuraoona","h":602,"j":30,"g":6203},{"a":7,"ar":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","tr":"dan enggan (memberikan) bantuan","lt":"WayamnaAAoona almaAAoona","h":602,"j":30,"g":6204}]}