{"n":109,"basmalah":true,"ayat":[{"a":1,"ar":"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","tr":"Katakanlah (Muhammad), \"Wahai orang-orang kafir","lt":"Qul ya ayyuha alkafiroona","h":603,"j":30,"g":6208},{"a":2,"ar":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","tr":"aku tidak akan menyembah apa yang kamu sembah","lt":"La aAAbudu ma taAAbudoona","h":603,"j":30,"g":6209},{"a":3,"ar":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","tr":"dan kamu bukan penyembah apa yang aku sembah","lt":"Wala antum AAabidoona ma aAAbudu","h":603,"j":30,"g":6210},{"a":4,"ar":"وَلَآ أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمۡ","tr":"dan aku tidak pernah menjadi penyembah apa yang kamu sembah","lt":"Wala ana AAabidun ma AAabadtum","h":603,"j":30,"g":6211},{"a":5,"ar":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","tr":"dan kamu tidak pernah (pula) menjadi penyembah apa yang aku sembah","lt":"Wala antum AAabidoona ma aAAbudu","h":603,"j":30,"g":6212},{"a":6,"ar":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","tr":"Untukmu agamamu, dan untukku agamaku","lt":"Lakum deenukum waliya deeni","h":603,"j":30,"g":6213}]}