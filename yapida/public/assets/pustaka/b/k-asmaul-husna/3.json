{"n":3,"judul":"Nama ke-21 sampai ke-40","blok":[{"t":"h","x":"21. Al-Basith"},{"t":"ar","x":"الْبَاسِطُ"},{"t":"p","x":"Yang Maha Melapangkan."},{"t":"h","x":"22. Al-Khafidh"},{"t":"ar","x":"الْخَافِضُ"},{"t":"p","x":"Yang Maha Merendahkan."},{"t":"h","x":"23. Ar-Rafi’"},{"t":"ar","x":"الرَّافِعُ"},{"t":"p","x":"Yang Maha Meninggikan."},{"t":"h","x":"24. Al-Mu’izz"},{"t":"ar","x":"الْمُعِزُّ"},{"t":"p","x":"Yang Maha Memuliakan."},{"t":"h","x":"25. Al-Mudzill"},{"t":"ar","x":"الْمُذِلُّ"},{"t":"p","x":"Yang Maha Menghinakan."},{"t":"h","x":"26. As-Sami’"},{"t":"ar","x":"السَّمِيعُ"},{"t":"p","x":"Yang Maha Mendengar."},{"t":"h","x":"27. Al-Bashir"},{"t":"ar","x":"الْبَصِيرُ"},{"t":"p","x":"Yang Maha Melihat."},{"t":"h","x":"28. Al-Hakam"},{"t":"ar","x":"الْحَكَمُ"},{"t":"p","x":"Yang Maha Menetapkan."},{"t":"h","x":"29. Al-‘Adl"},{"t":"ar","x":"الْعَدْلُ"},{"t":"p","x":"Yang Maha Adil."},{"t":"h","x":"30. Al-Lathif"},{"t":"ar","x":"اللَّطِيفُ"},{"t":"p","x":"Yang Maha Lembut."},{"t":"h","x":"31. Al-Khabir"},{"t":"ar","x":"الْخَبِيرُ"},{"t":"p","x":"Yang Maha Mengenal."},{"t":"h","x":"32. Al-Halim"},{"t":"ar","x":"الْحَلِيمُ"},{"t":"p","x":"Yang Maha Penyantun."},{"t":"h","x":"33. Al-‘Azhim"},{"t":"ar","x":"الْعَظِيمُ"},{"t":"p","x":"Yang Maha Agung."},{"t":"h","x":"34. Al-Ghafur"},{"t":"ar","x":"الْغَفُورُ"},{"t":"p","x":"Yang Maha Memberi Pengampunan."},{"t":"h","x":"35. Asy-Syakur"},{"t":"ar","x":"الشَّكُورُ"},{"t":"p","x":"Yang Maha Menghargai Kebaikan."},{"t":"h","x":"36. Al-‘Aliy"},{"t":"ar","x":"الْعَلِيُّ"},{"t":"p","x":"Yang Maha Tinggi."},{"t":"h","x":"37. Al-Kabir"},{"t":"ar","x":"الْكَبِيرُ"},{"t":"p","x":"Yang Maha Besar."},{"t":"h","x":"38. Al-Hafizh"},{"t":"ar","x":"الْحَفِيظُ"},{"t":"p","x":"Yang Maha Memelihara."},{"t":"h","x":"39. Al-Muqit"},{"t":"ar","x":"الْمُقِيتُ"},{"t":"p","x":"Yang Maha Pemberi Kecukupan."},{"t":"h","x":"40. Al-Hasib"},{"t":"ar","x":"الْحَسِيبُ"},{"t":"p","x":"Yang Maha Membuat Perhitungan."}]}