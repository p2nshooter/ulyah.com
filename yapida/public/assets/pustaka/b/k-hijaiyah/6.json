{"n":6,"judul":"Tanda Baca: Harakat","judulAr":"الْحَرَكَاتُ","blok":[{"t":"p","x":"Huruf hijaiyah diberi tanda baca supaya kita tahu cara membacanya. Tanda ini namanya harakat."},{"t":"h","x":"Fathah — garis di atas, dibaca \"a\""},{"t":"ar","x":"بَ"},{"t":"lt","x":"ba"},{"t":"ar","x":"تَ"},{"t":"lt","x":"ta"},{"t":"h","x":"Kasrah — garis di bawah, dibaca \"i\""},{"t":"ar","x":"بِ"},{"t":"lt","x":"bi"},{"t":"ar","x":"تِ"},{"t":"lt","x":"ti"},{"t":"h","x":"Dhammah — seperti koma di atas, dibaca \"u\""},{"t":"ar","x":"بُ"},{"t":"lt","x":"bu"},{"t":"ar","x":"تُ"},{"t":"lt","x":"tu"},{"t":"h","x":"Mari membaca bersama"},{"t":"ar","x":"بَ بِ بُ"},{"t":"ar","x":"تَ تِ تُ"},{"t":"ar","x":"كَتَبَ"},{"t":"p","x":"Kataba artinya menulis."},{"t":"p","x":"Hebat! Terus berlatih setiap hari di TPQ dan di rumah, ya. Ajak ayah dan ibu ikut mendengarkan."},{"t":"ar","x":"جَزَاكُمُ اللَّهُ خَيْرًا"},{"t":"tr","x":"Semoga Allah membalas kalian dengan kebaikan."}]}