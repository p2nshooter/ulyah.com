{"n":1,"judul":"Greetings","judulAr":"Salam","blok":[{"t":"en","x":"Assalamu’alaikum. Good morning, teacher!"},{"t":"tr","x":"Assalamu’alaikum. Selamat pagi, Bu Guru / Pak Guru!"},{"t":"en","x":"Good morning, everyone."},{"t":"tr","x":"Selamat pagi, semuanya."},{"t":"en","x":"How are you today?"},{"t":"tr","x":"Apa kabarmu hari ini?"},{"t":"en","x":"I am fine, alhamdulillah. Thank you."},{"t":"tr","x":"Aku baik, alhamdulillah. Terima kasih."},{"t":"en","x":"What is your name?"},{"t":"tr","x":"Siapa namamu?"},{"t":"en","x":"My name is Aisyah. Nice to meet you."},{"t":"tr","x":"Namaku Aisyah. Senang berkenalan denganmu."},{"t":"en","x":"See you tomorrow!"},{"t":"tr","x":"Sampai jumpa besok!"}]}