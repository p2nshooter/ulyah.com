{"n":2,"judul":"My Classroom","judulAr":"Kelasku","blok":[{"t":"en","x":"This is my classroom."},{"t":"tr","x":"Ini kelasku."},{"t":"en","x":"This is a book. That is a pencil."},{"t":"tr","x":"Ini buku. Itu pensil."},{"t":"en","x":"Please open your book."},{"t":"tr","x":"Silakan buka bukumu."},{"t":"en","x":"Please close the door."},{"t":"tr","x":"Tolong tutup pintunya."},{"t":"en","x":"May I go to the toilet, please?"},{"t":"tr","x":"Bolehkah saya ke kamar kecil?"},{"t":"en","x":"Let us read together."},{"t":"tr","x":"Mari kita membaca bersama."},{"t":"en","x":"I have a question."},{"t":"tr","x":"Saya punya pertanyaan."}]}